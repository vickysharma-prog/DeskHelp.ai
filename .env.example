# DeskHelp configuration.
#
# DeskHelp runs in dry-run mode with no credentials at all. Nothing here is
# needed for `npm run demo`, `npm run preview`, or the test suite.
#
# Copy to `.env` only when you intend to place real phone calls.

# --- CALL-E -----------------------------------------------------------------
# From https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# --- Live calling -----------------------------------------------------------
# Live calling stays off until this is exactly "true". Every other value,
# including "1", "yes" and "TRUE", leaves DeskHelp in dry-run.
DESKHELP_LIVE=false

# Comma-separated E.164 numbers DeskHelp is allowed to dial. A destination that
# is not on this list is refused before any plan is built, even when
# DESKHELP_LIVE is true. There is no wildcard.
DESKHELP_ALLOWED_DESTINATIONS=

# The institute's own timezone, as an IANA name (e.g. Asia/Kolkata).
# DeskHelp never infers a timezone from a phone number, country code or locale.
# 
DESKHELP_TIMEZONE=

# The jurisdiction whose calling rules apply, declared explicitly (e.g. IN).
# Never derived from the +91 on a number.
DESKHELP_JURISDICTION=

# --- the live call test -----------------------------------------------------
# The E.164 number you are authorised to call, for the demo video and for the
# first real call. Read only from here: it never appears in source, fixtures,
# or a commit. Everything printed masks it.
DESKHELP_TEST_PHONE=

# A second handset, so a workflow can be tested twice over without waiting out
# the contact cooldown. Each is its own contact, with its own history.
DESKHELP_TEST_PHONE_2=

# Spoken aloud when the wrong person answers, so they can reach a human.
# Defaults to the number above if unset.
DESKHELP_CALLBACK_NUMBER=

# Offers the shared demo login on the sign-in page. For the public demo only.
DESKHELP_DEMO=false
